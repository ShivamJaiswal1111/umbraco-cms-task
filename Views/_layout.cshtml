

<!DOCTYPE html>
<html lang="en">
<head>
    <title>@ViewData["Title"]</title>
    <meta name="description" content="@ViewData["MetaDescription"]" />
    <link rel="stylesheet" href="/css/site.css" />
    <style>
        :root {
            --brand-primary: @ViewData["BrandPrimary"];
            --brand-dark: @ViewData["BrandDark"];
        }
    </style>
</head>
<body class="site-@ViewData["SiteKey"]">
    @await Html.PartialAsync("Navigation")
    <div class="page-wrapper">
        @RenderBody()
    </div>
    <footer class="site-footer">
        <p>© 2026 <strong>@ViewData["BrandName"]</strong> — @ViewData["BrandTagline"]</p>
        <div class="footer-links">
            <a href="#">Privacy</a>
            <a href="#">Terms</a>
            <a href="#">Sitemap</a>
        </div>
    </footer>
</body>
</html>