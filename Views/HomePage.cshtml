@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "_layout.cshtml";
    await Html.RenderPartialAsync("BrandConfig");
    ViewData["Title"] = Model.Value<string>("sEOTitle") ?? Model.Name;
    ViewData["MetaDescription"] = Model.Value<string>("metaDescription") ?? "";
}

<div class="hero">
    <h1>@Model.Value("title")</h1>
</div>
<div>@Html.Raw(Model.Value<string>("body") ?? "")</div>