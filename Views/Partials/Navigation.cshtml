@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    var siteRoot = Model.Root();
    var allSites = Umbraco.ContentAtRoot();
    var topLevelPages = siteRoot.Children().Where(c => c.IsPublished());
}
<nav class="main-nav">
    <a href="@siteRoot.Url()" class="nav-brand">@siteRoot.Name</a>

    <ul class="nav-list">
        @foreach (var navPage in topLevelPages)
        {
            var navChildren = navPage.Children().Where(c => c.IsPublished());
            var hasChildren = navChildren.Any();

            <li class="nav-item @(hasChildren ? "has-children" : "")">
                <a href="@navPage.Url()">@navPage.Name</a>

                @if (hasChildren)
                {
                    <ul class="nav-dropdown">
                        @foreach (var navChild in navChildren)
                        {
                            var navGrandchildren = navChild.Children().Where(c => c.IsPublished());
                            var hasGrandchildren = navGrandchildren.Any();

                            <li class="nav-subitem @(hasGrandchildren ? "has-children" : "")">
                                <a href="@navChild.Url()">@navChild.Name</a>

                                @if (hasGrandchildren)
                                {
                                    <ul class="nav-sub-dropdown">
                                        @foreach (var navGrandchild in navGrandchildren)
                                        {
                                            <li><a href="@navGrandchild.Url()">@navGrandchild.Name</a></li>
                                        }
                                    </ul>
                                }
                            </li>
                        }
                    </ul>
                }
            </li>
        }
    </ul>
</nav>

<div class="site-switcher">
    Other sites:
    @foreach (var site in allSites.Where(s => s.Id != siteRoot.Id))
    {
        <a href="@site.Url()">@site.Name</a>
    }
</div>