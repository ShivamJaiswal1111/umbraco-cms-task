@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage
@{
    Layout = "_layout.cshtml";
    await Html.RenderPartialAsync("BrandConfig");
    ViewData["Title"] = Model.Value<string>("sEOTitle") ?? Model.Name;
    ViewData["MetaDescription"] = Model.Value<string>("metaDescription") ?? "";
}
<h1>@Model.Value("title")</h1>

@{
    var featuredImage = Model.Value<MediaWithCrops>("featuredImage");
}
@if (featuredImage != null)
{
    <img src="@featuredImage.Url()" alt="@Model.Value("title")" width="400" />
}

<p>By @Model.Value("author") — @Model.Value("publishDate")</p>
<div>@Html.Raw(Model.Value<string>("body") ?? "")</div>